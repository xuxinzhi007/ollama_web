#!/bin/bash

# 🚀 统一LoRA训练启动脚本
# 用法：
#   ./train                    # 交互式选择角色
#   ./train linzhi             # 直接训练指定角色
#   ./train --menu             # 显示完整菜单（推荐）
#   ./train --list             # 列出所有配置
#   ./train --scan             # 扫描数据集
#   ./train --cache            # 检查模型缓存状态
#   ./train linzhi --ollama    # 训练并导出到Ollama
#   ./train linzhi --ollama_name "my-model"  # 指定Ollama模型名

cd "$(dirname "$0")"

# 激活虚拟环境（如果存在）
if [ -d ".venv" ]; then
    source .venv/bin/activate
fi

# 检查并安装 questionary（用于箭头选择菜单）
if ! python -c "import questionary" 2>/dev/null; then
    echo "📦 正在安装 questionary (箭头选择菜单)..."
    pip install questionary >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        echo "✅ questionary 安装成功！"
        echo ""
    else
        echo "⚠️  questionary 安装失败，将使用传统数字输入"
        echo ""
    fi
fi

# 运行智能训练脚本
python smart_train.py "$@"